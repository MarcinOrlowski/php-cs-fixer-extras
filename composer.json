{
    "name": "marcin-orlowski/php-cs-fixer-extras",
    "description": "Extra fixers for PHP CS Fixer.",
    "type": "library",
    "version": "1.0.0",
    "keywords": [
        "php-cs-fixer",
        "fixer",
        "code-style",
        "static-analysis"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Marcin Orlowski",
            "email": "mail@marcinOrlowski.com"
        }
    ],
    "require": {
        "php": "~8.3 || ~8.4 || ~8.5",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "PCFE\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PCFE\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "php-cs-fixer fix --dry-run --diff --using-cache=no",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    }
}
